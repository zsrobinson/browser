# Copy to .env and fill in. Never commit .env.

# Your Synology user/group — run `id` over SSH (often uid 1026, gid 100).
PUID=1026
PGID=100
TZ=America/New_York

# Hostname the Claude connector uses (must match the tunnel route).
MCP_HOSTNAME=browsermcp.zsrobinson.com

# Cloudflare Zero Trust > Networks > Tunnels > your tunnel > token
TUNNEL_TOKEN=

# Base image registry. Default is GHCR. If ghcr.io is down or rate-limiting,
# switch to the identical Docker Hub copy and rebuild:
# BASE_IMAGE=linuxserver/chromium:latest

# Smoother viewer: WebRTC through Cloudflare's free TURN relay.
# Create the key per docs/cloudflare.md section 4, then uncomment all four.
# VIEWER_MODE=webrtc
# CLOUDFLARE_TURN=true
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
