# Copy to .env and fill in. Never commit .env.

# Your Synology user/group — run `id` over SSH (often uid 1026, gid 100).
PUID=1026
PGID=100
TZ=America/New_York

# Hostname the Claude connector uses (must match the tunnel route).
MCP_HOSTNAME=browsermcp.zsrobinson.com

# Cloudflare Zero Trust > Networks > Tunnels > your tunnel > token
TUNNEL_TOKEN=
